hods\n\n* getElementById\n* getElementsByClassName\n* getElementsByTagName\n* getElementsByName\n\n### Node\n\n#### Implemented properties\n\n* nodeType\n* nodeName\n* childNodes\n* firstChild\n* lastChild\n* parentNode\n* attributes\n* innerHTML\n* outerHTML\n* textContent\n\n#### Implemented methods\n\n* getAttribute\n* getElementById\n* getElementsByClassName\n* getElementsByTagName\n* getElementsByName\n\nUsage - https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement\n\n\n## Contributing\n\nIssues and pull requests are welcome!\n","versions":{"0.0.1":{"name":"dom-parser","version":"0.0.1","description":"","main":"index.js","scripts":{"test":"npm install && ./node_modules/.bin/mocha"},"author":{"name":"Konstantin Ershov"},"license":"ISC","gitHead":"a58db6f0267e2be5ca65ef6369592258c8182710","_id":"dom-parser@0.0.1","_shasum":"155dc9fd98963204f816e56024fd64172afb9133","_from":".","_npmVersion":"2.14.4","_nodeVersion":"4.1.1","_npmUser":{"name":"ershov-konst","email":"ershov.kosnt@gmail.com"},"maintainers":[{"name":"ershov-konst","email":"ershov.konst@gmail.com"}],"dist":{"shasum":"155dc9fd98963204f816e56024fd64172afb9133","tarball":"https://registry.npmjs.org/dom-parser/-/dom-parser-0.0.1.tgz","integrity":"sha512-xC2PhsSpeXKKBWO7uETPXgzfViOJ39j8IZLN/LjeCzkgZo1jmOgB9+KPP5pulKs4ewtgAGG0ugWuePOL8DaIYg==","signatures":[{"keyid":"SHA256:jl3bwswu80PjjokCgh0o2w5c2U4LhQAE57gj9cz1kzA","sig":"MEQCIGKB0Ky6ALXlr+wFSD8CmR/JnDJldh2WjB1jATg9Cl5fAiBxecKJ3jE4RuU6EhWKrUvxfBOvzwoKFkOKAtHj0AiPZQ=="}]},"directories":{}},"0.0.2":{"name":"dom-parser","version":"0.0.2","description":"Fast dom parser based on regexps","keywords":["domparser","dom","parser","xml","html","xmlparser","htmlparser","scraping"],"main":"index.js","devDependencies":{"mocha":"2.3.x","chai":"2.1.x"},"scripts":{"test":"npm install && ./node_modules/.bin/mocha"},"author":{"name":"Konstantin Ershov"},"license":"ISC","gitHead":"f2d299ac01c0b1456217be1b7cc6ad4c51cbdeb5","_id":"dom-parser@0.0.2","_shasum":"70f232b9f